{
  "name": "vasaros-kampelis",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "prebuild": "node scripts/generate-favicons.js && (node scripts/generate-image-variants.js || true)",
    "build": "vite build --mode production && node scripts/inject-sw-assets.js && npm run generate:sitemaps && npm run ping:sitemaps",
    "build:analyze": "vite build --mode production && npx vite-bundle-analyzer dist",
    "preview": "vite preview",
    "lint": "eslint src --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "generate:sitemaps": "node scripts/generate-sitemaps.js",
    "ping:sitemaps": "node scripts/ping-sitemaps.js"
  },
  "dependencies": {
    "@stripe/react-stripe-js": "^2.2.0",
    "@stripe/stripe-js": "^2.4.0",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.1",
    "@vercel/analytics": "^1.6.1",
    "@vercel/speed-insights": "^1.3.1",
    "date-fns": "^2.30.0",
    "firebase": "^10.7.1",
    "lucide-react": "^0.344.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-hook-form": "^7.48.2",
    "react-hot-toast": "^2.4.1",
    "react-intersection-observer": "^9.5.3",
    "react-query": "^3.39.3",
    "react-router-dom": "^6.30.1",
    "stripe": "^12.0.0",
    "uuid": "^9.0.1",
    "web-vitals": "^5.1.0",
    "zustand": "^4.4.7"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.0",
    "autoprefixer": "^10.4.17",
    "cssnano": "^7.0.0",
    "baseline-browser-mapping": "^2.10.0",
    "postcss": "^8.4.31",
    "rollup": "^4.52.5",
    "sharp": "^0.33.4",
    "tailwindcss": "^3.4.13",
    "terser": "^5.44.0",
    "typescript": "^5.3.3",
    "vite": "^5.4.0",
    "vite-plugin-pwa": "^0.19.8"
  }
}
